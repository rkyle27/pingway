# Names of the settings the bot reads. The real values are private and never stored in this repository.
DISCORD_TOKEN=
DEVELOPER_DISCORD_ID=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Database encryption: on by default. DB_SSL=off only if the database doesn't support it.
# DB_CA = the database host's CA certificate (optional, also verifies the server).
DB_SSL=
DB_CA=
OPENROUTER_API_KEY=
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_DAILY_CHARS=120000
